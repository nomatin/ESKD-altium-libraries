XHL0014 0 nHL0014 MY_LIB_LED_DS PARAMS: ISvalue=1.74866282599e-18 Nvalue=2 RSvalue=0
GHL0014 0 nHL0014 scale 0 .02
.DC VSCALE .5 1 .5
.PLOT DC V(therm)
.PLOT DC V(nHL0001)
.PLOT DC V(nHL0002)
.PLOT DC V(nHL0003)
.PLOT DC V(nHL0004)
.PLOT DC V(nHL0007)
.PLOT DC V(nHL0008)
.PLOT DC V(nHL0009)
.PLOT DC V(nHL0010)
