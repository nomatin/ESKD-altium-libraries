GHL0004 0 nHL0004 scale 0 .02
XHL0007 0 nHL0007 MY_LIB_LED_DS PARAMS: ISvalue=2.49764743936e-19 Nvalue=2 RSvalue=0
GHL0007 0 nHL0007 scale 0 .02
XHL0008 0 nHL0008 MY_LIB_LED_DS PARAMS: ISvalue=1.8006604178e-29 Nvalue=2 RSvalue=0
GHL0008 0 nHL0008 scale 0 .02
XHL0009 0 nHL0009 MY_LIB_LED_DS PARAMS: ISvalue=8.21368101376e-51 Nvalue=1 RSvalue=13.4860774673
GHL0009 0 nHL0009 scale 0 .02
XHL0010 0 nHL0010 MY_LIB_LED_DS PARAMS: ISvalue=3.70122335036e-32 Nvalue=1.10600411162 RSvalue=5.97834742796
