* Fixed diode temperature and independent resistor thermometer; global -55 C
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\LEDs\MY_LIB_LED_DS.ckt"
.OPTIONS TEMP=-55
VSCALE scale 0 DC 1
RTHERM therm 0 RTEST 1000
.MODEL RTEST R (TC1=.001 TNOM=25)
GTHERM 0 therm scale 0 .001
XHL0001 0 nHL0001 MY_LIB_LED_DS PARAMS: ISvalue=1.8006604178e-29 Nvalue=2 RSvalue=0
GHL0001 0 nHL0001 scale 0 .02
XHL0002 0 nHL0002 MY_LIB_LED_DS PARAMS: ISvalue=6.17954710579e-27 Nvalue=2 RSvalue=0
GHL0002 0 nHL0002 scale 0 .02
