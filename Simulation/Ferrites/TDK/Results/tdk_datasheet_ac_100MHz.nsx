* Datasheet impedance at 100MHz; zero bias
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\Ferrites\TDK\MPZ2012S300AT000_TERRA.ckt"
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\Ferrites\TDK\MPZ2012S101AT000_TERRA.ckt"
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\Ferrites\TDK\MPZ2012S221AT000_TERRA.ckt"
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\Ferrites\TDK\MPZ2012S331AT000_TERRA.ckt"
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\Ferrites\TDK\MPZ2012S601AT000_TERRA.ckt"
.include "C:\Users\Nomatin\Documents\Altium\MY_LIB\MY_LIB\Simulation\Ferrites\TDK\MPZ2012S102AT000_TERRA.ckt"
.OPTIONS TEMP=25
VDRV src 0 DC 0 AC 1
VSL0001 src nL0001 0
XL0001 nL0001 0 MPZ2012S300AT000_TERRA
VSL0002 src nL0002 0
XL0002 nL0002 0 MPZ2012S101AT000_TERRA
VSL0003 src nL0003 0
XL0003 nL0003 0 MPZ2012S221AT000_TERRA
VSL0004 src nL0004 0
XL0004 nL0004 0 MPZ2012S331AT000_TERRA
VSL0005 src nL0005 0
XL0005 nL0005 0 MPZ2012S601AT000_TERRA
VSL0006 src nL0006 0
XL0006 nL0006 0 MPZ2012S102AT000_TERRA
.AC LIN 1 100Meg 100Meg
.PLOT AC V(nL0001) I(VSL0001)
.PLOT AC V(nL0002) I(VSL0002)
.PLOT AC V(nL0003) I(VSL0003)
.PLOT AC V(nL0004) I(VSL0004)
.PLOT AC V(nL0005) I(VSL0005)
.PLOT AC V(nL0006) I(VSL0006)
.END
