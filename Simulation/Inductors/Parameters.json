{
  "schema_version": "1.0",
  "kind": "vls3012hbx_universal_inductor_parameters",
  "run_id": "run-20261117-vls3012hbx",
  "model_file": "work/Simulation/Inductors/MY_LIB_INDUCTOR.ckt",
  "subcircuit": "MY_LIB_INDUCTOR",
  "model_class": "passive R, L, C only; 4 electrical parameters per part, core-loss branch present but disabled (R1val=1e9)",
  "conditions": {
    "temperature_c": 25,
    "dc_bias_a": 0.0,
    "analysis": "small-signal AC, linear transient",
    "not_modelled": [
      "Isat saturation",
      "Itemp self-heating",
      "DC-bias dependence",
      "temperature dependence"
    ]
  },
  "provenance": {
    "datasheet": "input/inductor_commercial_power_vls3012hbx-n_en.pdf (Rev. 20210921) via input/spec.json",
    "blackbox": "spice/blackbox_targets.json (published terminal measurements of the reference black box: Rdc, L, f_SRF, |Z|max, |Z|/phase curves, step response)",
    "vendor_netlists_read": false,
    "note": "no vendor subcircuit, node name or internal element value was used"
  },
  "synthesis_recipe": {
    "Lval": "datasheet nominal inductance at the 1 MHz test frequency",
    "RDCval": "datasheet Rdc typ (the model returns exactly this value at DC)",
    "CPval": "1 / (2*pi*f_SRF)^2 / Lval, f_SRF = mean(Simple, Precision)",
    "RPval": "|Z|max = mean(Simple, Precision) at resonance",
    "R1val_L1val": "left at the disabled defaults; see core_loss_branch_decision"
  },
  "core_loss_branch_decision": {
    "tested": "a parallel R1+L1 core-loss branch was fitted for all 12 parts (see _analysis/variant_C.json)",
    "result": "the smallest acceptance margin is unchanged (identical to the 4-element tank in 12/12 parts); the optimiser only re-absorbed the branch into RPval",
    "additional_finding": "a parallel loss branch strong enough to correct the resistive part Re(Z) at 1..10 MHz would take more than 2 % of the step current at 1/tau and would break tran_trace",
    "decision": "branch kept in the topology for future families, disabled (R1val=1e9) and not written to the Excel table"
  },
  "excel_columns": [
    {
      "field": "IND_L",
      "param": "Lval",
      "unit": "H",
      "note": "nominal inductance"
    },
    {
      "field": "IND_RDC",
      "param": "RDCval",
      "unit": "ohm",
      "note": "DC resistance"
    },
    {
      "field": "IND_CP",
      "param": "CPval",
      "unit": "F",
      "note": "self-capacitance"
    },
    {
      "field": "IND_RP",
      "param": "RPval",
      "unit": "ohm",
      "note": "parallel loss resistor"
    }
  ],
  "params_defaults_in_model": {
    "R1val": {
      "value": 1000000000.0,
      "meaning": "core-loss branch resistance, 1e9 ohm = branch off"
    },
    "L1val": {
      "value": 1.0,
      "meaning": "core-loss branch inductance, irrelevant while off"
    }
  },
  "known_limitations": {
    "esr_q_at_1_to_10_mhz": "the model reproduces the resistive part Re(Z) of the Simple reference variant; the Precision variant has up to 2.5x larger ESR in that decade, so the model Q at 1 MHz coincides with the Simple variant and is that much optimistic against the Precision variant (see q_1mhz_model vs q_1mhz_blackbox in each part)",
    "not_a_core_loss_ladder": "no frequency-spread core-loss ladder: a parallel branch able to raise ESR at 1..10 MHz would take more than 2 % of the step current and break tran_trace",
    "no_bias_no_temperature": "Isat, Itemp, DC-bias and temperature dependence unmodelled"
  },
  "sim_netlist_template": "@DESIGNATOR %1 %2 @MODEL PARAMS: Lval=@IND_L RDCval=@IND_RDC CPval=@IND_CP RPval=@IND_RP",
  "pin_map": {
